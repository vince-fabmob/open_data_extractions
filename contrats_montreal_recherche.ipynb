{"nbformat":4,"nbformat_minor":5,"metadata":{"colab":{"name":"Contrats Montréal - recherche"},"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"cells":[{"cell_type":"markdown","id":"intro","metadata":{},"source":["# Recherche dans les contrats de Montréal\n","Exécuter la cellule suivante dans Google Colab. Les quatre CSV sont téléchargés depuis un instantané GitHub identifié par son commit. Aucun jeton requis pour un dépôt public.\n","Source municipale : https://donnees.montreal.ca/dataset/contrats-et-subventions-api\n","Modifier MOTS_CLES, RESOLUTION et ANNEE au début du code. ANNEE=None conserve toutes les années; le filtre annuel cherche les dates dans les colonnes dont le nom contient DATE et ne constitue pas une validation de la date d'autorisation.\n","Les correspondances textuelles sont des pistes, pas des contrats confirmés. Les doublons ne sont pas supprimés et les montants ne sont pas additionnés. Les colonnes originales sont conservées; les colonnes commençant par _ documentent la recherche.\n","Les exports CSV et le manifeste des sources sont regroupés dans une archive ZIP téléchargeable. Le notebook n'écrit rien sur GitHub."]},{"cell_type":"code","id":"recherche","metadata":{},"execution_count":null,"outputs":[],"source":["import io, re, json, unicodedata, zipfile, csv\n","from pathlib import Path\n","from datetime import datetime, timezone\n","import requests\n","import pandas as pd\n","from IPython.display import display\n","\n","REF = '940320ab0749f026df2143bdd6d73999dba9f7ca'\n","MOTS_CLES = ['Transdev', 'EasyMile', 'Easy Mile', 'navette autonome', 'navettes autonomes']\n","RESOLUTION = 'CE18 1332'\n","ANNEE = None\n","FICHIERS = ['contrats_comite_executif.csv', 'contrats_conseil_municipal.csv', 'contratsconseilsarrondissements.csv', 'contratsfonctionnaires.csv']\n","BASE = f'https://raw.githubusercontent.com/vince-fabmob/open_data_extractions/{REF}/'\n","OUT = Path('resultats_contrats_montreal')\n","OUT.mkdir(exist_ok=True)\n","\n","def normaliser(value):\n","    return ''.join(c for c in unicodedata.normalize('NFKD', str(value)) if not unicodedata.combining(c)).upper()\n","\n","def compact(value):\n","    return re.sub(r'[^A-Z0-9]', '', normaliser(value))\n","\n","resultats, resolutions, inventaire, erreurs = [], [], [], []\n","for fichier in FICHIERS:\n","    url = BASE + fichier\n","    try:\n","        response = requests.get(url, timeout=180)\n","        response.raise_for_status()\n","        contenu = response.content\n","        for encodage in ['utf-8-sig', 'cp1252', 'latin-1']:\n","            try:\n","                texte = contenu.decode(encodage)\n","                break\n","            except UnicodeDecodeError:\n","                continue\n","        delimiteur = csv.Sniffer().sniff(texte[:65536], delimiters=',;\t|').delimiter\n","        df = pd.read_csv(io.StringIO(texte), sep=delimiteur, dtype=str, keep_default_na=False)\n","        if len(df.columns) < 2:\n","            raise ValueError('Une seule colonne détectée : vérifier le séparateur.')\n","        colonnes = list(df.columns)\n","        print(f'\n{fichier}: {len(df):,} lignes; encodage={encodage}; séparateur={delimiteur!r}')\n","        print('Colonnes:', colonnes)\n","        texte_lignes = df.apply(lambda row: normaliser(' | '.join(row)), axis=1)\n","        motifs = [normaliser(m) for m in MOTS_CLES if m.strip()]\n","        masque_mots = texte_lignes.str.contains('|'.join(re.escape(m) for m in motifs), regex=True) if motifs else pd.Series(False, index=df.index)\n","        cible = compact(RESOLUTION)\n","        masque_resolution = texte_lignes.str.replace(r'[^A-Z0-9]', '', regex=True).str.contains(re.escape(cible), regex=True) if cible else pd.Series(False, index=df.index)\n","        masque_annee = pd.Series(True, index=df.index)\n","        dates = [c for c in colonnes if 'DATE' in normaliser(c)]\n","        if ANNEE is not None:\n","            if not dates:\n","                raise ValueError('Filtre annuel demandé, mais aucune colonne DATE détectée.')\n","            masque_annee = df[dates].apply(lambda col: col.str.contains(rf'(?<!\d){int(ANNEE)}(?!\d)', regex=True)).any(axis=1)\n","        df['_source_fichier'] = fichier\n","        df['_source_url'] = url\n","        df['_ligne_donnees'] = df.index + 1\n","        df['_resolution_recherchee_trouvee'] = masque_resolution\n","        selection = df.loc[(masque_mots | masque_resolution) & masque_annee].copy()\n","        resultats.append(selection)\n","        resolutions.append(df.loc[masque_resolution].copy())\n","        inventaire.append({'fichier': fichier, 'url': url, 'lignes': len(df), 'colonnes': colonnes, 'octets': len(contenu), 'encodage': encodage, 'separateur': delimiteur, 'correspondances': len(selection), 'resolution_toutes_annees': int(masque_resolution.sum())})\n","        display(selection.head(30))\n","        del df, texte, contenu, response, texte_lignes\n","    except Exception as exc:\n","        erreurs.append({'fichier': fichier, 'erreur': str(exc)})\n","        print(f'ECHEC {fichier}: {exc}')\n","\n","if not inventaire:\n","    raise RuntimeError('Aucun fichier traité. Vérifier les erreurs ci-dessus.')\n","retenus = pd.concat(resultats, ignore_index=True, sort=False).fillna('')\n","par_resolution = pd.concat(resolutions, ignore_index=True, sort=False).fillna('')\n","retenus.to_csv(OUT / 'correspondances.csv', index=False, encoding='utf-8-sig')\n","par_resolution.to_csv(OUT / 'resolution_toutes_annees.csv', index=False, encoding='utf-8-sig')\n","manifeste = {'commit_donnees': REF, 'date_execution_utc': datetime.now(timezone.utc).isoformat(), 'mots_cles': MOTS_CLES, 'resolution': RESOLUTION, 'annee': ANNEE, 'sources': inventaire, 'erreurs': erreurs}\n","(OUT / 'manifeste.json').write_text(json.dumps(manifeste, ensure_ascii=False, indent=2), encoding='utf-8')\n","archive = Path('resultats_contrats_montreal.zip')\n","with zipfile.ZipFile(archive, 'w', zipfile.ZIP_DEFLATED) as z:\n","    for nom in ['correspondances.csv', 'resolution_toutes_annees.csv', 'manifeste.json']:\n","        z.write(OUT / nom, arcname=nom)\n","print(f'\nTotal: {len(retenus)} correspondances; {len(par_resolution)} correspondances de résolution, toutes années.')\n","if erreurs:\n","    print('ATTENTION : résultats partiels; consulter les erreurs dans le manifeste.')\n","display(par_resolution)\n","try:\n","    from google.colab import files\n","    files.download(str(archive))\n","except ImportError:\n","    print(f'Archive disponible localement : {archive.resolve()}')\n"]}]}